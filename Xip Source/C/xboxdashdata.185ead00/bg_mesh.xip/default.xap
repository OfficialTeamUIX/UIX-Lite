function LoadBGMeshValues()
{
	var SkinFile = new Settings;
	var CurrentSkin = GetSavedValue("default","CurrentSkin");
	var sPath = GetSkinConfigPath(CurrentSkin);
	SkinFile.file = sPath;
	SkinFile.section = "BGMesh";
	
	var theDNA = SkinFile.GetValue("BGMesh").toLowerCase();
	var DNAAlpha = SkinFile.GetValue("BGMeshAlpha");
	
	///dna spinner
	var x = SkinFile.GetValue("BGMesh1-rpm");
	var y = SkinFile.GetValue("BGMesh2-rpm");
	var z = SkinFile.GetValue("BGMesh3-rpm");

	if((x == "") | (y == "") | (z == "")) { x = 2; y = 2; z = 2; }

	theDNA1.children[0].rpm = x;
	theDNA3.children[0].rpm = y;
	theDNA5.children[0].rpm = z;
	theDNA1.SetAlpha(DNAAlpha);
	theDNA3.SetAlpha(DNAAlpha);
	theDNA5.SetAlpha(DNAAlpha);
	
	var dnaMesh = "blank_mesh.xm";
	var dnaBackingMesh = "blank_mesh.xm";

	if (theDNA == "chains")
	{
		dnaMesh = "chain.xm";
	}
	else if ((theDNA == "spirals") | (theDNA == "corkscrews"))
	{
		dnaMesh = theDNA + ".xm";
	}
	else if (theDNA == "dna")
	{
		dnaMesh = "Backing_dna.xm";
		dnaBackingMesh = "Backing_dna_SIDES.xm";
	}
	else if (theDNA == "squigles")
	{
		dnaMesh = "Backing_squigles.xm";
		dnaBackingMesh = "Backing_squigles_sides.xm";
	}
	
	DNA1_Mesh.url = dnaMesh;
	DNA3_Mesh.url = dnaMesh;
	DNA5_Mesh.url = dnaMesh;
	DNAString1_Mesh.url = dnaBackingMesh;
	DNAString3_Mesh.url = dnaBackingMesh;
	DNAString5_Mesh.url = dnaBackingMesh;
}
