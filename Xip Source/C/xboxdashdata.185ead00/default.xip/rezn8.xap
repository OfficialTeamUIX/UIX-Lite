	c.theMemory_inner.visible = false;
	c.theSettings_inner.visible = false;

	if(bFromUpdate) 
	{
		c.theMovieUnit.fade = 0.01;
		c.theGamesUnit.fade = 0.01;
		c.theMusicUnit.fade = 0.01;
		c.theMemoryUnit.fade = 0.01;
		c.theSettingsUnit.fade = 0.01; 
